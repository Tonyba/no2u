{% doc %}
  @prompt
    key ingredients with photo on the left, and 9 individual ingredient blocks with icon and description
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredients-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-ingredients-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: start;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-ingredients-photo-{{ ai_gen_id }} {
    position: sticky;
    top: 20px;
    width: 100%;
  }

  .ai-ingredients-photo-wrapper-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-ingredients-photo-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-ingredients-photo-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-ingredients-photo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ingredients-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
  }

  .ai-ingredients-list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-ingredient-item-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-ingredient-item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-ingredient-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_spacing }}px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
  }

  .ai-ingredient-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-ingredient-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ingredient-icon-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-ingredient-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.name_color }};
    margin: 0 0 8px;
  }

  .ai-ingredient-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-ingredients-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-ingredients-photo-{{ ai_gen_id }} {
      position: relative;
      top: 0;
    }

    .ai-ingredients-list-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-ingredients-list-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-ingredients-container-{{ ai_gen_id }} {
      gap: 20px;
    }
  }
{% endstyle %}

<key-ingredients-{{ ai_gen_id }} class="ai-ingredients-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ingredients-container-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;">
    <div class="ai-ingredients-photo-{{ ai_gen_id }}">
      <div class="ai-ingredients-photo-wrapper-{{ ai_gen_id }}">
        {% if block.settings.main_image %}
          <img
            src="{{ block.settings.main_image | image_url: width: 800 }}"
            alt="{{ block.settings.main_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.main_image.width }}"
            height="{{ block.settings.main_image.height }}"
          >
        {% else %}
          <div class="ai-ingredients-photo-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
            <div class="ai-ingredients-empty-state-{{ ai_gen_id }}">
              Add a main image
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-ingredients-list-{{ ai_gen_id }}">
      {% for i in (1..9) %}
        {% liquid
          assign name_key = 'ingredient_' | append: i | append: '_name'
          assign description_key = 'ingredient_' | append: i | append: '_description'
          assign icon_key = 'ingredient_' | append: i | append: '_icon'
          
          assign ingredient_name = block.settings[name_key]
          assign ingredient_description = block.settings[description_key]
          assign ingredient_icon = block.settings[icon_key]
        %}

        <div class="ai-ingredient-item-{{ ai_gen_id }}">
          <div class="ai-ingredient-icon-{{ ai_gen_id }}">
            {% if ingredient_icon %}
              <img
                src="{{ ingredient_icon | image_url: width: 200 }}"
                alt="{{ ingredient_name | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-ingredient-icon-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          
          {% if ingredient_name != blank %}
            <h3 class="ai-ingredient-name-{{ ai_gen_id }}">{{ ingredient_name }}</h3>
          {% else %}
            <h3 class="ai-ingredient-name-{{ ai_gen_id }}">Ingredient {{ i }}</h3>
          {% endif %}
          
          {% if ingredient_description != blank %}
            <p class="ai-ingredient-description-{{ ai_gen_id }}">{{ ingredient_description }}</p>
          {% else %}
            <p class="ai-ingredient-description-{{ ai_gen_id }}">Add a description for this ingredient</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</key-ingredients-{{ ai_gen_id }}>

<script>
  (function() {
    class KeyIngredients{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('key-ingredients-{{ ai_gen_id }}', KeyIngredients{{ ai_gen_id }});
  })();
</script>

