{% doc %}
  @prompt
    key ingredient section with title, description, photo on left, 6 ingredient sections with icons and description
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-key-ingredients-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-key-ingredients-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-key-ingredients-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-key-ingredients-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
    font-weight: 600;
  }

  .ai-key-ingredients-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-key-ingredients-content-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .ai-key-ingredients-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-key-ingredients-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: block;
  }

  .ai-key-ingredients-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-key-ingredients-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-key-ingredients-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-key-ingredients-list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .ai-key-ingredient-item-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .ai-key-ingredient-icon-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-key-ingredient-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
  }

  .ai-key-ingredient-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-key-ingredient-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-key-ingredient-content-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-key-ingredient-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_name_size }}px;
    color: {{ block.settings.ingredient_name_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-key-ingredient-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_description_size }}px;
    color: {{ block.settings.ingredient_description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 768px) {
    .ai-key-ingredients-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .ai-key-ingredients-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-key-ingredients-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<key-ingredients-{{ ai_gen_id }} class="ai-key-ingredients-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-key-ingredients-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.description != blank %}
      <div class="ai-key-ingredients-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-key-ingredients-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-key-ingredients-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-key-ingredients-content-{{ ai_gen_id }}">
      <div class="ai-key-ingredients-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.main_image %}
          <img
            src="{{ block.settings.main_image | image_url: width: 800 }}"
            alt="{{ block.settings.main_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.main_image.width }}"
            height="{{ block.settings.main_image.height }}"
            class="ai-key-ingredients-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-key-ingredients-image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
            <div class="ai-key-ingredients-empty-state-{{ ai_gen_id }}">
              Add a product image
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-key-ingredients-list-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign name_key = 'ingredient_' | append: i | append: '_name'
            assign description_key = 'ingredient_' | append: i | append: '_description'
            assign icon_key = 'ingredient_' | append: i | append: '_icon'
            
            assign ingredient_name = block.settings[name_key]
            assign ingredient_description = block.settings[description_key]
            assign ingredient_icon = block.settings[icon_key]
          %}

          {% if ingredient_name != blank or ingredient_description != blank %}
            <div class="ai-key-ingredient-item-{{ ai_gen_id }}">
              <div class="ai-key-ingredient-icon-wrapper-{{ ai_gen_id }}">
                {% if ingredient_icon %}
                  <img
                    src="{{ ingredient_icon | image_url: width: 100 }}"
                    alt="{{ ingredient_name | escape }}"
                    loading="lazy"
                    class="ai-key-ingredient-icon-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-key-ingredient-icon-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-key-ingredient-content-{{ ai_gen_id }}">
                {% if ingredient_name != blank %}
                  <h3 class="ai-key-ingredient-name-{{ ai_gen_id }}">{{ ingredient_name }}</h3>
                {% endif %}
                {% if ingredient_description != blank %}
                  <div class="ai-key-ingredient-description-{{ ai_gen_id }}">{{ ingredient_description }}</div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</key-ingredients-{{ ai_gen_id }}>

<script>
  (function() {
    class KeyIngredients{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('key-ingredients-{{ ai_gen_id }}', KeyIngredients{{ ai_gen_id }});
  })();
</script>

