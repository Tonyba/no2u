{% doc %}
  @prompt
    ingredients, add photo on left, 9 ingredient spots, add icons to ingredient
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredients-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-ingredients-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    align-items: flex-start;
    width: 100%;
  }

  .ai-ingredients-image-wrapper-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}%;
    max-width: {{ block.settings.image_width }}%;
  }

  .ai-ingredients-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: block;
  }

  .ai-ingredients-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-ingredients-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ingredients-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-ingredients-content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-ingredients-heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-ingredients-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns }}, 1fr);
    gap: {{ block.settings.ingredient_gap }}px;
  }

  .ai-ingredients-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: {{ block.settings.ingredient_padding }}px;
    background-color: {{ block.settings.ingredient_bg_color }};
    border-radius: {{ block.settings.ingredient_border_radius }}px;
    border: {{ block.settings.ingredient_border_width }}px solid {{ block.settings.ingredient_border_color }};
  }

  .ai-ingredients-item-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ai-ingredients-item-icon-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_bg_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-ingredients-item-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-ingredients-item-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ingredients-item-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ingredients-item-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.ingredient_name_color }};
    margin: 0;
  }

  .ai-ingredients-item-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.ingredient_description_size }}px;
    color: {{ block.settings.ingredient_description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-ingredients-item-empty-{{ ai_gen_id }} {
    font-size: 14px;
    color: #999;
    font-style: italic;
    text-align: center;
    padding: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-ingredients-container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-ingredients-image-wrapper-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 100%;
    }

    .ai-ingredients-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-ingredients-container-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
      margin: 0 auto;
    }
  }
{% endstyle %}

<ingredients-block-{{ ai_gen_id }} class="ai-ingredients-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ingredients-container-{{ ai_gen_id }}">
    <div class="ai-ingredients-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-ingredients-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-ingredients-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
          <div class="ai-ingredients-empty-state-{{ ai_gen_id }}">
            Add an image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-ingredients-content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-ingredients-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      <div class="ai-ingredients-grid-{{ ai_gen_id }}">
        {% for i in (1..9) %}
          {% liquid
            assign name_key = 'ingredient_' | append: i | append: '_name'
            assign description_key = 'ingredient_' | append: i | append: '_description'
            assign icon_key = 'ingredient_' | append: i | append: '_icon'
            assign ingredient_name = block.settings[name_key]
            assign ingredient_description = block.settings[description_key]
            assign ingredient_icon = block.settings[icon_key]
          %}

          <div class="ai-ingredients-item-{{ ai_gen_id }}">
            {% if ingredient_name != blank or ingredient_description != blank %}
              <div class="ai-ingredients-item-header-{{ ai_gen_id }}">
                {% if block.settings.show_icons %}
                  <div class="ai-ingredients-item-icon-wrapper-{{ ai_gen_id }}">
                    {% if ingredient_icon %}
                      <img
                        src="{{ ingredient_icon | image_url: width: 100 }}"
                        alt="{{ ingredient_name | escape }}"
                        loading="lazy"
                        width="100"
                        height="100"
                        class="ai-ingredients-item-icon-{{ ai_gen_id }}"
                      >
                    {% else %}
                      <div class="ai-ingredients-item-icon-placeholder-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
                {% if ingredient_name != blank %}
                  <h3 class="ai-ingredients-item-name-{{ ai_gen_id }}">{{ ingredient_name }}</h3>
                {% endif %}
              </div>
              {% if ingredient_description != blank %}
                <p class="ai-ingredients-item-description-{{ ai_gen_id }}">{{ ingredient_description }}</p>
              {% endif %}
            {% else %}
              <div class="ai-ingredients-item-empty-{{ ai_gen_id }}">
                Ingredient {{ i }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</ingredients-block-{{ ai_gen_id }}>

<script>
  (function() {
    class IngredientsBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('ingredients-block-{{ ai_gen_id }}', IngredientsBlock{{ ai_gen_id }});
  })();
</script>

