{% doc %}
  @prompt
    ingredients
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ingredients-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-ingredients-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-ingredients-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-ingredients-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 {{ block.settings.title_margin }}px 0;
    font-weight: 600;
  }

  .ai-ingredients-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-ingredients-list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax({{ block.settings.card_min_width }}px, 1fr));
    gap: {{ block.settings.card_gap }}px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-ingredient-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.card_text_alignment }};
  }

  .ai-ingredient-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin: 0 auto {{ block.settings.icon_margin }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-ingredient-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-ingredient-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.icon_placeholder_bg }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-ingredient-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-ingredient-name-{{ ai_gen_id }} {
    color: {{ block.settings.ingredient_name_color }};
    font-size: {{ block.settings.ingredient_name_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.ingredient_name_margin }}px 0;
  }

  .ai-ingredient-benefit-{{ ai_gen_id }} {
    color: {{ block.settings.ingredient_benefit_color }};
    font-size: {{ block.settings.ingredient_benefit_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-ingredients-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 0;
    }

    .ai-ingredients-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-ingredients-list-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax({{ block.settings.card_min_width | times: 0.8 }}px, 1fr));
      gap: {{ block.settings.card_gap | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-ingredients-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ingredients-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.description != blank %}
      <div class="ai-ingredients-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-ingredients-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-ingredients-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <ul class="ai-ingredients-list-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign ingredient_name_key = 'ingredient_' | append: i | append: '_name'
          assign ingredient_benefit_key = 'ingredient_' | append: i | append: '_benefit'
          assign ingredient_icon_key = 'ingredient_' | append: i | append: '_icon'
          
          assign ingredient_name = block.settings[ingredient_name_key]
          assign ingredient_benefit = block.settings[ingredient_benefit_key]
          assign ingredient_icon = block.settings[ingredient_icon_key]
        %}

        {% if ingredient_name != blank or ingredient_benefit != blank %}
          <li class="ai-ingredient-card-{{ ai_gen_id }}">
            <div class="ai-ingredient-icon-wrapper-{{ ai_gen_id }}">
              {% if ingredient_icon %}
                <img
                  src="{{ ingredient_icon | image_url: width: 200 }}"
                  alt="{{ ingredient_name | escape }}"
                  class="ai-ingredient-icon-{{ ai_gen_id }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                <div class="ai-ingredient-icon-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if ingredient_name != blank %}
              <h3 class="ai-ingredient-name-{{ ai_gen_id }}">{{ ingredient_name }}</h3>
            {% endif %}
            {% if ingredient_benefit != blank %}
              <p class="ai-ingredient-benefit-{{ ai_gen_id }}">{{ ingredient_benefit }}</p>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>

