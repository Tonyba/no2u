{% doc %}
  @prompt
    clinical studies
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-clinical-studies-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-clinical-studies__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-clinical-studies__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-clinical-studies__title-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .ai-clinical-studies__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-clinical-studies__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: {{ block.settings.card_spacing }}px;
    margin-bottom: 32px;
  }

  .ai-clinical-studies__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ai-clinical-studies__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-clinical-studies__card-header-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
  }

  .ai-clinical-studies__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-clinical-studies__icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.icon_size }}px * 0.5);
    height: calc({{ block.settings.icon_size }}px * 0.5);
    stroke: {{ block.settings.icon_color }};
  }

  .ai-clinical-studies__card-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_title_color }};
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .ai-clinical-studies__card-meta-{{ ai_gen_id }} {
    color: {{ block.settings.meta_color }};
    font-size: {{ block.settings.meta_size }}px;
    margin: 0 0 16px 0;
  }

  .ai-clinical-studies__card-content-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.content_size }}px;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .ai-clinical-studies__stat-{{ ai_gen_id }} {
    background-color: {{ block.settings.stat_background }};
    border-radius: 8px;
    padding: 16px;
    margin-bottom: 16px;
  }

  .ai-clinical-studies__stat-value-{{ ai_gen_id }} {
    color: {{ block.settings.stat_value_color }};
    font-size: {{ block.settings.stat_value_size }}px;
    font-weight: 700;
    margin: 0 0 4px 0;
  }

  .ai-clinical-studies__stat-label-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.stat_label_size }}px;
    margin: 0;
  }

  .ai-clinical-studies__link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.link_color }};
    font-size: {{ block.settings.link_size }}px;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .ai-clinical-studies__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-clinical-studies__link-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
  }

  .ai-clinical-studies__footer-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 40px;
  }

  .ai-clinical-studies__cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: {{ block.settings.cta_background }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: {{ block.settings.cta_size }}px;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }

  .ai-clinical-studies__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-clinical-studies__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-clinical-studies__card-{{ ai_gen_id }} {
      padding: 24px;
    }
  }
{% endstyle %}

<clinical-studies-{{ ai_gen_id }} class="ai-clinical-studies-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-clinical-studies__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.description != blank %}
      <div class="ai-clinical-studies__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-clinical-studies__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-clinical-studies__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-clinical-studies__grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign study_enabled_key = 'study_' | append: i | append: '_enabled'
          assign study_title_key = 'study_' | append: i | append: '_title'
          assign study_source_key = 'study_' | append: i | append: '_source'
          assign study_date_key = 'study_' | append: i | append: '_date'
          assign study_description_key = 'study_' | append: i | append: '_description'
          assign study_stat_value_key = 'study_' | append: i | append: '_stat_value'
          assign study_stat_label_key = 'study_' | append: i | append: '_stat_label'
          assign study_link_key = 'study_' | append: i | append: '_link'
          assign study_link_text_key = 'study_' | append: i | append: '_link_text'

          assign study_enabled = block.settings[study_enabled_key]
          assign study_title = block.settings[study_title_key]
          assign study_source = block.settings[study_source_key]
          assign study_date = block.settings[study_date_key]
          assign study_description = block.settings[study_description_key]
          assign study_stat_value = block.settings[study_stat_value_key]
          assign study_stat_label = block.settings[study_stat_label_key]
          assign study_link = block.settings[study_link_key]
          assign study_link_text = block.settings[study_link_text_key]
        %}

        {% if study_enabled %}
          <div class="ai-clinical-studies__card-{{ ai_gen_id }}">
            <div class="ai-clinical-studies__card-header-{{ ai_gen_id }}">
              <div class="ai-clinical-studies__icon-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
                </svg>
              </div>
              <div>
                {% if study_title != blank %}
                  <h3 class="ai-clinical-studies__card-title-{{ ai_gen_id }}">{{ study_title }}</h3>
                {% endif %}
                {% if study_source != blank or study_date != blank %}
                  <p class="ai-clinical-studies__card-meta-{{ ai_gen_id }}">
                    {% if study_source != blank %}{{ study_source }}{% endif %}
                    {% if study_source != blank and study_date != blank %} • {% endif %}
                    {% if study_date != blank %}{{ study_date }}{% endif %}
                  </p>
                {% endif %}
              </div>
            </div>

            {% if study_description != blank %}
              <div class="ai-clinical-studies__card-content-{{ ai_gen_id }}">
                {{ study_description }}
              </div>
            {% endif %}

            {% if study_stat_value != blank or study_stat_label != blank %}
              <div class="ai-clinical-studies__stat-{{ ai_gen_id }}">
                {% if study_stat_value != blank %}
                  <p class="ai-clinical-studies__stat-value-{{ ai_gen_id }}">{{ study_stat_value }}</p>
                {% endif %}
                {% if study_stat_label != blank %}
                  <p class="ai-clinical-studies__stat-label-{{ ai_gen_id }}">{{ study_stat_label }}</p>
                {% endif %}
              </div>
            {% endif %}

            {% if study_link != blank and study_link_text != blank %}
              <a href="{{ study_link }}" class="ai-clinical-studies__link-{{ ai_gen_id }}" target="_blank" rel="noopener">
                {{ study_link_text }}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.cta_text != blank and block.settings.cta_link != blank %}
      <div class="ai-clinical-studies__footer-{{ ai_gen_id }}">
        <a href="{{ block.settings.cta_link }}" class="ai-clinical-studies__cta-{{ ai_gen_id }}">
          {{ block.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</clinical-studies-{{ ai_gen_id }}>

<script>
  (function() {
    class ClinicalStudies{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('clinical-studies-{{ ai_gen_id }}', ClinicalStudies{{ ai_gen_id }});
  })();
</script>

