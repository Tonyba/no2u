{% stylesheet %}
  .free-shipping-badge {
    padding: 7px 27px;
    background-color: #c92531;
    color: white;
    font-weight: bold;
    font-size: 16px;
    display: block;
    width: max-content;
    margin-left: auto;
    margin-bottom: -47px;
  }

  @media only screen and (max-width: 767px) {
    .free-shipping-badge { 
       font-size: 12px;
        padding: 7px 12px;
    }

    .free-shipping-badge svg {
      width: 20px;
    }

     .free-shipping-badge .flex {
       gap: 5px; 
     }
   
  }

{% endstylesheet %}

<div class="flex items-center">
  <div class="icon">
    {{ 'delivery-truck.svg' | inline_asset_content }}
  </div>
  <div class="text">
    {% if block.settings.text != blank %}
      {{ block.settings.text }}
    {% else %}
      Free Shippin
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Free Shipping Badge",
  "class": "free-shipping-badge",
  "settings": [
    {
      "type": "checkbox",
      "id": "black_ver",
      "label": "Show Black Version",
      "default": false
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    }
  ],
  "presets": [
    {
      "name": "Free Shipping Badge"
    }
  ]
}
{% endschema %}
