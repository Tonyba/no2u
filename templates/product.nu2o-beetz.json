            "text_D6h8FY": {
              "type": "text",
              "name": "t:names.description",
              "settings": {
                "css_class": "",
                "text": "<p><strong>Fermented Beet Powder:</strong> A concentrated source of natural nitrates, fermented for better absorption and a smoother energy release. It supports nitric oxide production to boost circulation and performance.</p><p><strong>D-Ribose:</strong> A naturally occurring sugar molecule that fuels cellular energy production, helping to improve stamina and reduce muscle soreness after exercise.</p><p><strong>PEAK ATP®: </strong>A patented ingredient that improves cellular energy production. It helps muscles perform better, recover faster, and reduces fatigue.</p><p><strong>Electrolytes: </strong>A carefully balanced blend designed to support optimal hydration and promote overall cellular function, helping your body maintain the proper balance of fluids and essential nutrients it needs to perform at its best.</p><p><strong>Vitamin C:</strong> Provides essential antioxidant support and boosts immune health.</p><p><strong>Zinc: </strong>Supports immune health and cellular function.</p><p><strong>Vitamin D:</strong> Supports bone health and immune function.</p><p><strong>Magnesium: </strong>Supports muscle function and energy production</p><p><strong>Other Ingredients:</strong> Citric Acid, Sea Salt, Rebaudioside A (Stevia Extract), Malic Acid, Natural Flavors<br/><br/></p>",
                "width": "100%",
                "max_width": "none",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
