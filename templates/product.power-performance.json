              "settings": {
                "css_class": "",
                "text": "<h2>Performance Benefits of the Power & Performance</h2>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h4",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
