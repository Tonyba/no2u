                  ]
                },
                "accordion_row_REAF6Q": {
                  "type": "_accordion-row",
                  "name": "t:names.accordion_row",
                  "settings": {
                    "heading": "What’s your return and refund policy?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_LYBmbM": {
                      "type": "text",
                      "settings": {
                        "css_class": "",
                        "text": "<p>We are committed to bringing you innovative products of the highest quality. Contact us at <a href=\"mailto:hello@no2u.com\">support@no2u.com</a> if you have a question about your order.</p><p>NO2U offers a 60-day money-back guarantee on all orders. The 60-day return window begins the day your order is received.<strong>Shipping is not included in our return policy and shipping charges for your original purchase are non-refundable.</strong>Items shipped outside of the 60-day return window may not be credited back or returned to you. NO2U is not responsible for any duties or taxes for returned items.</p><p>Please allow up to 30 days for returns to be processed. Once a refund has been processed, it can take up to 5-10 business days to process back to your account.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_size": "1rem",
                        "line_height": "normal",
                        "letter_spacing": "normal",
                        "case": "none",
