                  ]
                },
                "accordion_row_N9AyCR": {
                  "type": "_accordion-row",
                  "name": "t:names.accordion_row",
                  "settings": {
                    "heading": "Where do you ship, and how long does it take?",
                    "open_by_default": false,
                    "icon": "none",
                    "width": 20
                  },
                  "blocks": {
                    "text_ihU8TJ": {
                      "type": "text",
                      "settings": {
                        "css_class": "",
                        "text": "<p>Orders placed before 11:00 AM CST Monday through Friday (excluding holidays) usually ship within 1 business day during non-sale periods. Please note that during times of exceptional volume during major sale periods your shipping time may be extended. Rest assured, our team strives to get your order to you as quickly as possible. </p><p>NO2U is pleased to offer international shipping. Our standard shipping methods for international orders are DHL, Global Access, and UPS. *Some exceptions can occur depending on order amount and region.</p>",
                        "width": "100%",
                        "max_width": "normal",
                        "alignment": "left",
